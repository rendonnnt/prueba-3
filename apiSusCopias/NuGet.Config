<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Los paquetes NuGet se restauran dentro de este mismo proyecto (carpeta packages),
         para que las referencias funcionen al abrir el proyecto solo, sin solución -->
    <add key="repositoryPath" value="packages" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
